<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_view_form_update" model="ir.ui.view">
        <field name="name">res.partner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="hr.res_partner_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_employees']" position="replace">
                <field name="has_matching_employee" invisible="True"/>
                <field name="is_employee" invisible="True"/>
                <button name="action_open_employees" type="object" class="oe_stat_button" icon="fa-id-card-o"
                        invisible="is_employee == False"
                        string="Dipendenti">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="has_matching_employee" field_id="has_matching_employee"/></span>
                        <span class="o_stat_text">Employee</span>
                    </div>
                    <field name="id" invisible="1"/>
                </button>
            </xpath>
<!--            <xpath expr="//div[@name='vat_vies_container']" position="after">-->
<!--                <div>-->
<!--                    <field name="access_code_employee" invisible="True"/>-->
<!--                </div>-->
<!--            </xpath>-->
            <xpath expr="//field[@name='category_id']" position="before">
                <field name="email_personale"/>
            </xpath>
        </field>
    </record>

    <record id="gtms_res_partner_form_inherit_2" model="ir.ui.view">
        <field name="name">res.partner</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="gtms.res_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_driver']" position="after">
                <field name="login_user" invisible="is_driver != True"/>
                <field name="access_code_employee" invisible="is_driver != True" readonly="1" groups="!base.group_system"/>
                <field name="access_code_employee" invisible="is_driver != True" groups="base.group_system"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="res_partner_form_view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="generate_new_random_password_login_employee" string="Genera password dipendente" type="object" groups="hr.group_hr_user" invisible="not active"/>
                </header>
            </xpath>

        </field>
    </record>


</odoo>
