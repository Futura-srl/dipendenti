<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- In Odoo 19 il portale e' stato riscritto: portal.portal_my_details_fields non esiste
         piu' e i campi del contatto stanno in portal.address_form_fields, che legge da
         partner_sudo e non ha piu' il dizionario `error` (la validazione e' passata al JS). -->
    <template id="portal_my_details_fields" inherit_id="portal.address_form_fields" name="Welcome Message">
        <xpath expr="//input[@name='name']" position="attributes">
            <attribute name="readonly">1</attribute>
        </xpath>
        <xpath expr="//input[@name='email']" position="attributes">
            <attribute name="readonly">1</attribute>
        </xpath>
        <xpath expr="//div[@id='div_email']" position="after">
            <div id="div_email_personale" class="col-lg-6 mb-2">
                <label class="col-form-label" for="o_email_personale">Email personale</label>
                <input id="o_email_personale" type="email" name="email_personale"
                       t-att-value="partner_sudo.email_personale" class="form-control"/>
            </div>
        </xpath>
    </template>
</odoo>
